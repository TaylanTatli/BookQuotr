# ---------------------------------------------------------------------------
# BookQuotr environment configuration
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# SQLite database location. Relative to the working directory, so the same
# value works for local development (./data) and Docker (/app/data).
DATABASE_URL="file:./data/bookquotr.db"

# --- Authentication --------------------------------------------------------
# Production runs with authentication ENABLED by default. Set a username,
# a password, and a strong random secret. Generate a secret with:
#   openssl rand -base64 32
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me-to-a-strong-password"
AUTH_SECRET=""

# Session lifetime in days (default: 30).
# AUTH_SESSION_DAYS="30"

# Set to "false" ONLY for a trusted, private deployment where you do not want a
# login screen. Everyone who can reach the server then has full access.
# AUTH_ENABLED="false"

# --- Optional --------------------------------------------------------------
# Expose GET /api/quotes/random without authentication (never returns notes).
# PUBLIC_RANDOM_QUOTES="false"

# Optional Google Books API key (raises the quota from 100 to 1000 req/day).
GOOGLE_BOOKS_API_KEY=""
